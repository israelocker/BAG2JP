+/* Host movie layer (BAG2JP local addition): clear the window to black and
+ * draw a BGRA frame (row 0 = top) fitted to the window with its own aspect,
+ * linear filtered. `upload` = 0 redraws the texture already uploaded. Meant
+ * for title HUD callbacks (psx_host_set_hud_draw_cb): same thread and GL
+ * context as the present. Leaves blending/scissor disabled like the OSD. */
+void gl_renderer_draw_host_movie(const uint32_t *bgra, int w, int h,
+                                 int upload, int ww, int wh) {
+    if (!s_present_prog || ww <= 0 || wh <= 0) return;
+    p_glBindFramebuffer(PSXGL_DRAW_FRAMEBUFFER, 0);
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_STENCIL_TEST);
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_BLEND);
+    if (p_glBlendEquationSeparate)
+        p_glBlendEquationSeparate(PSXGL_FUNC_ADD, PSXGL_FUNC_ADD);
+    glViewport(0, 0, ww, wh);
+    glClearColor(0.f, 0.f, 0.f, 1.f);
+    glClear(GL_COLOR_BUFFER_BIT);
+    if (!bgra || w <= 0 || h <= 0) return;
+    if (!s_movie_tex) glGenTextures(1, &s_movie_tex);
+    p_glActiveTexture(PSXGL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, s_movie_tex);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    if (s_movie_tw != w || s_movie_th != h) {
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0,
+                     GL_BGRA, GL_UNSIGNED_BYTE, bgra);
+        s_movie_tw = w;
+        s_movie_th = h;
+    } else if (upload) {
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, w, h,
+                        GL_BGRA, GL_UNSIGNED_BYTE, bgra);
+    }
+    int dw = ww, dh = (int)((long long)ww * h / w);
+    if (dh > wh) { dh = wh; dw = (int)((long long)wh * w / h); }
+    const int vx = (ww - dw) / 2, vy = (wh - dh) / 2;
+    glViewport(vx, wh - vy - dh, dw, dh);
+    p_glUseProgram(s_present_prog);
+    p_glUniform1i(s_present_uTex, 0);
+    present_set_gamma(s_present_uGamma, 0);
+    present_set_sharp(0, 0, 0, 0, 0);
+    PRESENT_SCANLINE(0, 0, 0);
+    p_glUniform4f(s_present_uUvRect, 0.f, 0.f, 1.f, 1.f);
+    p_glBindVertexArray(s_present_vao);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    p_glBindVertexArray(0);
+    p_glUseProgram(0);
+    glViewport(0, 0, ww, wh);
+}
+
+/* Host overlay layer (BAG2JP local addition): like the movie layer but drawn
+ * over the frame already in the window, alpha blended, into the centred 4:3
+ * area (where 4:3 game screens such as menus are shown). */
+void gl_renderer_draw_host_overlay(const uint32_t *bgra, int w, int h,
+                                   int upload, int ww, int wh) {
+    if (!s_present_prog || ww <= 0 || wh <= 0 || !bgra || w <= 0 || h <= 0) return;
+    p_glBindFramebuffer(PSXGL_DRAW_FRAMEBUFFER, 0);
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_STENCIL_TEST);
+    glDisable(GL_DEPTH_TEST);
+    if (!s_overlay_tex) glGenTextures(1, &s_overlay_tex);
+    p_glActiveTexture(PSXGL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, s_overlay_tex);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    if (s_overlay_tw != w || s_overlay_th != h) {
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0,
+                     GL_BGRA, GL_UNSIGNED_BYTE, bgra);
+        s_overlay_tw = w;
+        s_overlay_th = h;
+    } else if (upload) {
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, w, h,
+                        GL_BGRA, GL_UNSIGNED_BYTE, bgra);
+    }
+    int dw = ww, dh = (int)((long long)ww * 3 / 4);
+    if (dh > wh) { dh = wh; dw = (int)((long long)wh * 4 / 3); }
+    const int vx = (ww - dw) / 2, vy = (wh - dh) / 2;
+    glEnable(GL_BLEND);
+    if (p_glBlendEquationSeparate)
+        p_glBlendEquationSeparate(PSXGL_FUNC_ADD, PSXGL_FUNC_ADD);
+    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+    glViewport(vx, wh - vy - dh, dw, dh);
+    p_glUseProgram(s_present_prog);
+    p_glUniform1i(s_present_uTex, 0);
+    present_set_gamma(s_present_uGamma, 0);
+    present_set_sharp(0, 0, 0, 0, 0);
+    PRESENT_SCANLINE(0, 0, 0);
+    p_glUniform4f(s_present_uUvRect, 0.f, 0.f, 1.f, 1.f);
+    p_glBindVertexArray(s_present_vao);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    p_glBindVertexArray(0);
+    p_glUseProgram(0);
+    glDisable(GL_BLEND);
+    glViewport(0, 0, ww, wh);
+}
