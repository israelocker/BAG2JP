 /* Opt-in presentation hold for a game that retains its previous framebuffer
  * while loading. The pure, cheap emulation-thread predicate returns HOLD
  * only while that SAME scene remains displayed; no GPU/API recursion allowed.
diff --git a/runtime/src/gpu.c b/runtime/src/gpu.c
index 40641694..9414c663 100644
--- a/runtime/src/gpu.c
+++ b/runtime/src/gpu.c
@@ -645,6 +645,41 @@ static int ws_nw_offset(void) {
     return ws_nw_configured_offset();
 }
 int gpu_ws_configured_x_reveal(void) { return ws_nw_configured_offset(); }
+int gpu_display_pixel_aspect(uint32_t *numerator, uint32_t *denominator) {
+    GpuDisplayInfo di;
+    uint64_t width, n, d, a, b;
+    int present_num = 4, present_den = 3;
+    if (numerator) *numerator = 0;
+    if (denominator) *denominator = 0;
+    if (!numerator || !denominator || numerator == denominator ||
+        ws_local_viewport_cfg) return 0;
+    if (ws_cfg_num <= 0 || ws_cfg_den <= 0) return 0;
+    memset(&di, 0, sizeof(di));
+    gpu_get_display_info(&di);
+    if (di.disabled || di.depth24 || !di.width || !di.height) return 0;
+    width = di.width;
+    /* Use the presenter's classifier, not the window/settings aspect. In
+     * native-wide the same target aspect spans more raw display columns; in
+     * squash mode the original columns are stretched into that aspect. */
+    if (!gpu_ws_present_native_43()) {
+        present_num = ws_cfg_num;
+        present_den = ws_cfg_den;
+        if (ws_native_wide_active()) {
+            int offset = ws_nw_offset();
+            if (offset < 0) return 0;
+            width += (uint64_t)offset * 2u;
+        }
+    }
+    n = (uint64_t)present_num * di.height;
+    d = (uint64_t)present_den * width;
+    a = n; b = d;
+    while (b) { uint64_t remainder = a % b; a = b; b = remainder; }
+    n /= a; d /= a;
+    if (n > UINT32_MAX || d > UINT32_MAX) return 0;
+    *numerator = (uint32_t)n;
+    *denominator = (uint32_t)d;
+    return 1;
+}
 int ws_nw_extra(void) { return 2 * ws_nw_offset(); }
 
