+/* Read-only presentation query, on the emulation thread. Returns the reduced
+ * physical width/height ratio of a pixel in the raw display coordinate space,
+ * including projection-and-stretch or native-wide presentation. Does not apply
+ * the GTE squash to custom packets. Returns 0 (and clears outputs) for missing
+ * display geometry, 24-bit video or local-viewport configuration; skip then.
+ * The current frame classifier may still change before presentation: callers
+ * must validate transitions in-game. Not a host-window size/settings query. */
+#define PSX_MOD_DISPLAY_PIXEL_ASPECT 1
+int psx_mod_display_pixel_aspect(uint32_t *numerator, uint32_t *denominator);
