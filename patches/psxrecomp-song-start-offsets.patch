+/* settings.toml [song_sync] start_offset_ms: negative read, out of range
+ * (-10000..10000) ignored, and a launcher save round-trips it. */
+static void test_user_settings_song_start_offset() {
+    fs::path p = write_temp("psxrecomp_song_sync.toml", "[song_sync]\nstart_offset_ms = -120\n");
+    auto us = PSXRecompV4::load_user_settings(p);
+    check(us.has_song_start_offset_ms && us.song_start_offset_ms == -120, "start_offset_ms read");
+    fs::remove(p);
+    p = write_temp("psxrecomp_song_sync_r.toml", "[song_sync]\nstart_offset_ms = 20000\n");
+    us = PSXRecompV4::load_user_settings(p);
+    check(!us.has_song_start_offset_ms, "out-of-range start_offset_ms ignored");
+    fs::remove(p);
+    PSXRecompV4::UserSettings out;
+    out.song_start_offset_ms = 200; out.has_song_start_offset_ms = true;
+    p = fs::temp_directory_path() / "psxrecomp_song_sync_rt.toml";
+    check(PSXRecompV4::save_user_settings(p, out), "save_user_settings writes start_offset_ms");
+    auto back = PSXRecompV4::load_user_settings(p);
+    check(back.has_song_start_offset_ms && back.song_start_offset_ms == 200,
+          "start_offset_ms survives a save/load round trip");
+    fs::remove(p);
+    p = write_temp("psxrecomp_song_sync_n.toml",
+                   "[song_sync]\nheat = 120\nbag1_gaso = -40\ncomet = 99999\n");
+    us = PSXRecompV4::load_user_settings(p);
+    /* toml11 tables are unordered: compare as a set. */
+    auto has = [&](const char *n, int v) {
+        for (const auto& so : us.song_offsets_ms)
+            if (so.first == n && so.second == v) return true;
+        return false;
+    };
+    check(!us.has_song_start_offset_ms && us.song_offsets_ms.size() == 2 &&
+          has("heat", 120) && has("bag1_gaso", -40),
+          "named song offsets read, out-of-range ignored");
+    fs::remove(p);
+    out.song_offsets_ms = {{"strike", 75}};
+    p = fs::temp_directory_path() / "psxrecomp_song_sync_nrt.toml";
+    check(PSXRecompV4::save_user_settings(p, out), "save_user_settings writes named offsets");
+    back = PSXRecompV4::load_user_settings(p);
+    check(back.song_start_offset_ms == 200 && back.song_offsets_ms.size() == 1 &&
+          back.song_offsets_ms[0].second == 75, "named offsets survive a save/load round trip");
+    fs::remove(p);
+}
