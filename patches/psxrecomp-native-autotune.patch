+extern "C" {
+__declspec(dllexport) unsigned long NvOptimusEnablement = 0x00000001;
+__declspec(dllexport) int AmdPowerXpressRequestHighPerformance = 1;
+}
+
+static void psx_autotune_detect_defaults(int *out_width, int *out_render_thread) {
+    unsigned int threads = std::thread::hardware_concurrency();
+    if (threads == 0) threads = 2;
+
+    MEMORYSTATUSEX mem_status = {};
+    mem_status.dwLength = sizeof(mem_status);
+    double ram_gb = 8.0;
+    if (GlobalMemoryStatusEx(&mem_status)) {
+        ram_gb = (double)mem_status.ullTotalPhys / (1024.0 * 1024.0 * 1024.0);
+    }
+
+    int max_level = 1; /* 0:1280, 1:1920, 2:2560, 3:3840 */
+    static const int kWidths[4] = { 1280, 1920, 2560, 3840 };
+
+    typedef HRESULT (WINAPI *PFN_CreateDXGIFactory1)(REFIID, void **);
+    HMODULE dxgi_mod = LoadLibraryA("dxgi.dll");
+    if (dxgi_mod) {
+        auto pCreate = reinterpret_cast<PFN_CreateDXGIFactory1>(
+            GetProcAddress(dxgi_mod, "CreateDXGIFactory1"));
+        IDXGIFactory1 *factory = nullptr;
+        if (pCreate && SUCCEEDED(pCreate(__uuidof(IDXGIFactory1), (void **)&factory)) && factory) {
+            double best_vram_gb = 0.0;
+            bool best_integrated = true;
+            IDXGIAdapter1 *adapter = nullptr;
+            for (UINT i = 0; factory->EnumAdapters1(i, &adapter) != DXGI_ERROR_NOT_FOUND; ++i) {
+                DXGI_ADAPTER_DESC1 desc = {};
+                if (SUCCEEDED(adapter->GetDesc1(&desc))) {
+                    if ((desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) == 0) {
+                        double vram_gb = (double)desc.DedicatedVideoMemory / (1024.0 * 1024.0 * 1024.0);
+                        bool integrated = (desc.DedicatedVideoMemory < (512ULL * 1024ULL * 1024ULL));
+                        if (vram_gb > best_vram_gb) {
+                            best_vram_gb = vram_gb;
+                            best_integrated = integrated;
+                        }
+                    }
+                }
+                adapter->Release();
+            }
+            factory->Release();
+            if (best_integrated || best_vram_gb < 2.0) max_level = 0;
+            else if (best_vram_gb < 4.0) max_level = 1;
+            else if (best_vram_gb < 8.0) max_level = 2;
+            else max_level = 3;
+        }
+        FreeLibrary(dxgi_mod);
+    }
+
+    if (threads < 4 || ram_gb < 8.0) {
+        if (max_level > 1) max_level = 1;
+    }
+
+    if (out_width) *out_width = kWidths[max_level];
+    if (out_render_thread) *out_render_thread = (threads >= 4) ? 1 : 0;
+}
+#endif
